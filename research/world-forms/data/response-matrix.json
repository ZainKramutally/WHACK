 "lava": {
  "question": "Lava as a 5th Sea swatch or the Heat extreme?",
  "options": [
   {
    "option": "5th Sea swatch",
    "pros": [
     "one tap, distinct palette",
     "easy to pitch"
    ],
    "cons": [
     "lava at Heat=cold is nonsense, so Sea and Heat stop being independent",
     "needs a new palette, stain and anchors",
     "breaks the 4-swatch Sea UI and ART_DIRECTION sea table"
    ]
   },
