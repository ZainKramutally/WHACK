    "option": "Heat extreme (heat > ~0.92, strongest with Si+O)",
    "pros": [
     "physically honest: lava is molten Si+O, i.e. the Recipe melted",
     "no new UI",
     "gives Heat a dramatic far end and the Venus surface a home"
    ],
    "cons": [
     "only reachable by pushing a slider to the end",
     "palette field needs an incandescence override above the threshold"
    ]
   }
  ],
  "recommendation": "Heat extreme. Ship as the 'melt' end of the Heat slider; columnar jointing appears as Heat comes back down.",
  "tag": "[sci] lava worlds plausible (Demory 2016); [game] placement"
 },
